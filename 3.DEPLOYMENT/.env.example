# Local development only. Never used in a pod.
#
# NO CREDENTIALS HERE. Not blank-but-present, not commented-out. boto3 falls through to
# ~/.aws/credentials. A key in .env is both a leak vector and a SHADOWING hazard:
# environment variables take precedence over the shared credentials file, so a stale key
# here silently overrides a freshly configured one and you get InvalidAccessKeyId against
# a credential you just fixed.
#
# In a pod these values come from the ConfigMap and identity comes from IRSA. Passing
# aws_access_key_id= in code OVERRIDES AND DISABLES IRSA.

AWS_REGION=ap-south-2
S3_BUCKET=qcomm-rfm
ENV_PREFIX=dev
ROLE=api
PORT=8000
STRICT_LIBS=true

# No value above contains a space. `set -a; source .env` parses `KEY=1. DATA/x.csv` as an
# assignment prefix plus a COMMAND — on a case-insensitive filesystem that has executed a
# CSV as a shell script. Prefer explicit `export` over `source .env`.
