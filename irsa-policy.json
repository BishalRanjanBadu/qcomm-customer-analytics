{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": "arn:aws:s3:::qcomm-rfm",
     "Condition": {"StringLike": {"s3:prefix": ["dev/*"]}}},
    {"Effect": "Allow", "Action": ["s3:GetObject"], "Resource": "arn:aws:s3:::qcomm-rfm/dev/*"}
  ]
}
